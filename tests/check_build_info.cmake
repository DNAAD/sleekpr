set(arguments "-DSOURCE_ROOT=${CMAKE_SOURCE_DIR}" "-DOUTPUT_HEADER=${header}" "-DVERSION=${PROJECT_VERSION}" "-DCONFIGURATION=Debug" "-DTEMPLATE=@BUILD_TEMPLATE@")
