cmake_minimum_required(VERSION 3.24)

function(assert_equal actual expected description)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${description}: actual=[${actual}], expected=[${expected}]")
    endif()
endfunction()

function(run_cli output_name)
    execute_process(COMMAND "${APP_EXE}" --build-info-json RESULT_VARIABLE code
        OUTPUT_VARIABLE json ERROR_VARIABLE errors TIMEOUT 20)
    assert_equal("${code}" "0" "诊断命令退出码")
    string(JSON schema ERROR_VARIABLE parse_error GET "${json}" schemaVersion)
    if(parse_error)
        message(FATAL_ERROR "诊断不是有效 JSON: ${json}; ${errors}")
    endif()
    set(${output_name} "${json}" PARENT_SCOPE)
endfunction()

string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef nonce)
set(case_root "${TEST_ROOT}/${CASE}-${nonce}")
file(MAKE_DIRECTORY "${case_root}")

if(CASE STREQUAL "reportsBuildModeAndRevision")
    run_cli(json)
    string(JSON mode GET "${json}" configuration)
    assert_equal("${mode}" "${EXPECTED_CONFIG}" "实际构建模式")
    find_program(git_program git REQUIRED)
    execute_process(COMMAND "${git_program}" -C "${SOURCE_ROOT}" rev-parse HEAD OUTPUT_VARIABLE expected OUTPUT_STRIP_TRAILING_WHITESPACE)
    string(JSON revision GET "${json}" revision)
    assert_equal("${revision}" "${expected}" "完整提交标识")
    string(JSON version GET "${json}" version)
    assert_equal("${version}" "${EXPECTED_VERSION}" "统一项目版本")
    return()
elseif(CASE STREQUAL "diagnosticDoesNotTouchUserSettings")
    set(ENV{APPDATA} "${case_root}/appdata")
    set(ENV{LOCALAPPDATA} "${case_root}/local")
