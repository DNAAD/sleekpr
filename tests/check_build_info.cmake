function(build_fixture)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    assert_equal("${status}" "0" "临时增量构建: ${output} ${errors}")
endfunction()
build_fixture()
file(READ "${build}/artifact.txt" before)
file(WRITE "${source}/src/untracked.cpp" "int changed = 2;\n")
build_fixture()
file(READ "${build}/artifact.txt" after)
if(before STREQUAL after)
    message(FATAL_ERROR "无需重新配置的构建未更新未跟踪源码标识")
