    run_cli(json)
    if(EXISTS "$ENV{APPDATA}/zytxt/sleekpr")
        message(FATAL_ERROR "诊断创建了操作员配置目录")
    endif()
    return()
endif()

set(source "${case_root}/source")
set(header "${case_root}/generated/BuildVersion.h")
file(MAKE_DIRECTORY "${source}/src" "${source}/docs")
file(WRITE "${source}/CMakeLists.txt" "project(Fixture VERSION 1.2.3)\n")
file(WRITE "${source}/src/value.cpp" "int fixture = 1;\n")
# 阻止无 Git 夹具向上误发现真实项目的仓库，所有提交只发生在自己的临时 source 目录。
set(ENV{GIT_CEILING_DIRECTORIES} "${case_root}")

function(run_generator)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DSOURCE_ROOT=${source}" "-DOUTPUT_HEADER=${header}"
        "-DVERSION=1.2.3" "-DCONFIGURATION=Debug" "-DTEMPLATE=${BUILD_TEMPLATE}" -P "${GENERATOR_SCRIPT}"
        RESULT_VARIABLE status ERROR_VARIABLE errors)
    assert_equal("${status}" "0" "构建标识生成命令: ${errors}")
endfunction()

function(read_macro name output_name)
    file(STRINGS "${header}" lines REGEX "^#define ${name} ")
    string(REGEX REPLACE "^#define ${name} \"?([^\"\r\n]*)\"?$" "\\1" value "${lines}")
    set(${output_name} "${value}" PARENT_SCOPE)
endfunction()

function(run_git)
    execute_process(COMMAND "${git_program}" -C "${source}" -c user.name=Fixture -c user.email=fixture@example.invalid
        "-c" "core.hooksPath=${case_root}/no-hooks" -c commit.gpgsign=false ${ARGN}
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    assert_equal("${status}" "0" "临时 Git 命令: ${output} ${errors}")
endfunction()

if(CASE STREQUAL "marksMissingGitUnknown")
    run_generator()
    read_macro(SLEEKPR_BUILD_REVISION revision)
    read_macro(SLEEKPR_BUILD_SOURCE_DIRTY dirty)
    read_macro(SLEEKPR_BUILD_WORKSPACE_DIRTY workspace)
    read_macro(SLEEKPR_BUILD_SOURCE_DIGEST digest)
    assert_equal("${revision}" "unknown" "无 Git 标识")
    assert_equal("${dirty}" "-1" "无 Git 源码状态")
    assert_equal("${workspace}" "-1" "无 Git 工作区状态")
    string(LENGTH "${digest}" digest_length)
    assert_equal("${digest_length}" "64" "无 Git 时仍有源码指纹")
    return()
endif()

find_program(git_program git REQUIRED)
run_git(init -q)
run_git(add .)
run_git(commit -qm "初始化临时版本夹具")

if(CASE STREQUAL "distinguishesDocsFromSourceDirty")
    run_generator()
    read_macro(SLEEKPR_BUILD_SOURCE_DIRTY clean)
    read_macro(SLEEKPR_BUILD_SOURCE_DIGEST first_digest)
    assert_equal("${clean}" "0" "初始源码应干净")
    file(WRITE "${source}/docs/note.md" "仅文档改动\n")
    run_generator()
    read_macro(SLEEKPR_BUILD_SOURCE_DIRTY dirty)
    read_macro(SLEEKPR_BUILD_WORKSPACE_DIRTY workspace)
    read_macro(SLEEKPR_BUILD_SOURCE_DIGEST docs_digest)
    assert_equal("${dirty}" "0" "文档不应伪报源码改动")
    assert_equal("${workspace}" "1" "工作区应包含文档改动")
    assert_equal("${docs_digest}" "${first_digest}" "文档不改变源码指纹")
    file(WRITE "${source}/src/untracked.cpp" "int untracked = 2;\n")
    run_generator()
    read_macro(SLEEKPR_BUILD_SOURCE_DIRTY dirty)
    read_macro(SLEEKPR_BUILD_SOURCE_DIGEST updated_digest)
    assert_equal("${dirty}" "1" "未跟踪源码应标脏")
    if(updated_digest STREQUAL docs_digest)
        message(FATAL_ERROR "未跟踪源码未改变指纹")
    endif()
    return()
elseif(NOT CASE STREQUAL "updatesWithoutManualReconfigure")
    message(FATAL_ERROR "未知构建信息测试: ${CASE}")
endif()

