#pragma code_page(65001)
#include <windows.h>

// 固定能力标记用于安全探测，旧程序不支持该命令时绝不能为读取版本而启动它。
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG | VS_FF_PRIVATEBUILD
#else
 FILEFLAGS VS_FF_PRIVATEBUILD
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "sleekpr 原生标签打印客户端\0"
   VALUE "FileVersion", "@PROJECT_VERSION@\0"
   VALUE "ProductName", "sleekpr\0"
   VALUE "ProductVersion", "@PROJECT_VERSION@\0"
   VALUE "PrivateBuild", "sleekpr-build-info-json-v1\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
